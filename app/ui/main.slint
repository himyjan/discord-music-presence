// Kizzy Enhanced — faithful desktop reproduction.
// Palette, typography, spacing and component shapes mirror the Android app's
// Discord Dark / Discord Light schemes and its Compose component specs.

import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Kizzy Discord theme tokens (theme/Color.kt + theme/Theme.kt)
// ---------------------------------------------------------------------------
global AppTheme {
    in-out property<bool> dark: true;

    // Brand + surfaces
    out property<color> primary: #5865f2;
    out property<color> on-primary: #ffffff;
    out property<color> primary-container: root.dark ? #5865f2 : #e0e3ff;
    out property<color> on-primary-container: root.dark ? #ffffff : #1e1f4b;
    out property<color> secondary: #5865f2;
    out property<color> secondary-container: root.dark ? #1a1a1e : #ffffff;
    out property<color> on-secondary-container: root.dark ? #f2f3f5 : #060607;
    out property<color> tertiary: root.dark ? #57f287 : #23a55a;

    out property<color> background: root.dark ? #000000 : #f2f3f5;
    out property<color> surface: root.dark ? #000000 : #ffffff;
    out property<color> on-surface: root.dark ? #f2f3f5 : #060607;
    out property<color> surface-variant: root.dark ? #1a1a1e : #ffffff;
    out property<color> on-surface-variant: root.dark ? #b5bac1 : #4e5058;
    out property<color> surface-high: root.dark ? #232428 : #f2f3f5;
    out property<color> outline: root.dark ? #3f4147 : #c4c6ce;
    out property<color> inverse-surface: root.dark ? #f2f3f5 : #2f3033;

    // Text (kept for compatibility / high-contrast surfaces)
    out property<color> text: root.on-surface;
    out property<color> muted: root.on-surface-variant;
    out property<color> subtle: root.dark ? #949ba4 : #6d6f78;

    // Status
    out property<color> green: root.dark ? #57f287 : #23a55a;
    out property<color> yellow: root.dark ? #fee75c : #c8912b;
    out property<color> red: root.dark ? #ed4245 : #da373c;
    out property<color> logout-red: #f23f43;
    out property<color> on-brand: #ffffff;

    // Activity type chip colours
    out property<color> playing-color: #1976d2;
    out property<color> streaming-color: #9c27b0;
    out property<color> listening-color: #43a047;
    out property<color> watching-color: #ff9800;
    out property<color> competing-color: #f44336;
}

export global AppLocalization {
    in property <[string]> language_options: [];
    in-out property <string> selected_language: "English";
    in-out property <string> current_locale: "";
    callback language_selected(string);
    pure callback translate(string, string) -> string;
}

// ---------------------------------------------------------------------------
// Shared components — mirror Kizzy's common/components specs
// ---------------------------------------------------------------------------

// KSwitch: 56x28 track, 14 radius, 20 thumb, offset 4 -> 32
component KSwitch inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    callback toggled();
    width: 56px;
    height: 28px;
    border-radius: 14px;
    opacity: root.enabled ? 1 : 0.5;
    background: root.checked ? AppTheme.primary : AppTheme.surface-variant;
    Rectangle {
        x: root.checked ? 32px : 4px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? AppTheme.on-primary : AppTheme.outline;
        animate x { duration: 150ms; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(); }
    }
}

// SwitchBar: full-width 28-radius pill, primaryContainer bg, title + switch
component SwitchBar inherits Rectangle {
    in property<string> title;
    in property<bool> enabled: true;
    in-out property<bool> checked;
    callback toggled();
    height: 64px;
    border-radius: 28px;
    background: root.enabled ? AppTheme.primary-container : AppTheme.surface-variant;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 8px;
        Text {
            text: root.title;
            color: root.enabled ? AppTheme.on-primary-container : AppTheme.on-surface-variant;
            font-size: 16px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        KSwitch { checked <=> root.checked; enabled: root.enabled; toggled => { root.toggled(); } }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(); }
    }
}

// FeatureCard: 84px tall, 24 radius, 3-stop gradient, icon 40, title 22 W500, switch
component FeatureCard inherits Rectangle {
    in property<image> icon;
    in property<string> title;
    in property<string> page;
    in-out property<string> current-page;
    in-out property<bool> checked;
    in property<bool> show-switch: true;
    callback navigate(string);
    callback toggled(bool);
    height: 84px;
    border-radius: 24px;
    background: root.checked
        ? @linear-gradient(0deg, AppTheme.primary-container 0%, AppTheme.primary-container 40%, AppTheme.primary-container 100%)
        : @linear-gradient(0deg, AppTheme.secondary-container 0%, AppTheme.secondary-container 40%, AppTheme.secondary-container 100%);
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 20px;
        Image {
            source: root.icon;
            width: 40px;
            height: 40px;
            image-fit: contain;
            colorize: root.checked ? AppTheme.primary : AppTheme.secondary;
        }
        Text {
            text: root.title;
            color: root.checked ? AppTheme.on-primary-container : AppTheme.on-secondary-container;
            font-size: 22px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.show-switch: KSwitch {
            checked <=> root.checked;
            toggled => { root.toggled(root.checked); }
        }
    }
    TouchArea { clicked => { root.navigate(root.page); } }
}

// PreferenceSwitch: Surface row, 24 icon, 20 title, 14 desc, switch
component PreferenceSwitch inherits Rectangle {
    in property<string> title;
    in property<string> description;
    in property<image> icon;
    in-out property<bool> checked;
    callback toggled();
    min-height: 72px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        Image { source: root.icon; width: 24px; height: 24px; image-fit: contain; colorize: AppTheme.secondary; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: AppTheme.on-surface; font-size: 20px; font-weight: 500; wrap: word-wrap; }
            if root.description != "": Text { text: root.description; color: AppTheme.on-surface-variant; font-size: 14px; wrap: word-wrap; }
        }
        KSwitch { checked <=> root.checked; toggled => { root.toggled(); } }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

// Subtitle: primary-coloured label (Kizzy Subtitle / labelLarge)
component SubtitleText inherits Text {
    in property<string> label;
    text: root.label;
    color: AppTheme.primary;
    font-size: 14px;
    font-weight: 600;
}

// RpcField: label above a filled text field
component RpcField inherits VerticalLayout {
    in property<string> label;
    in-out property<string> value;
    in property<string> placeholder;
    in property<bool> secret: false;
    in property<bool> enabled: true;
    spacing: 4px;
    Text { text: root.label; color: AppTheme.on-surface-variant; font-size: 14px; }
    Rectangle {
        height: 52px;
        border-radius: 8px;
        background: AppTheme.surface-variant;
        LineEdit {
            text <=> root.value;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
            input-type: root.secret ? InputType.password : InputType.text;
        }
    }
}

// Card: Kizzy Surface card
component Card inherits Rectangle {
    in property<length> pad: 16px;
    background: AppTheme.surface-variant;
    border-radius: 16px;
    VerticalLayout {
        padding: root.pad;
        spacing: 10px;
        @children
    }
}

component GhostButton inherits Rectangle {
    in property<string> label;
    in property<bool> active: true;
    callback clicked();
    height: 40px;
    min-width: 100px;
    border-radius: 20px;
    background: AppTheme.secondary-container;
    opacity: root.active ? 1 : 0.5;
    Text { text: root.label; color: AppTheme.on-secondary-container; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { enabled: root.active; clicked => { root.clicked(); } }
}

component AccentButton inherits Rectangle {
    in property<string> label;
    in property<bool> active: true;
    callback clicked();
    height: 40px;
    min-width: 120px;
    border-radius: 20px;
    background: root.active ? AppTheme.primary : AppTheme.surface-variant;
    Text { text: root.label; color: root.active ? AppTheme.on-primary : AppTheme.on-surface-variant; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { enabled: root.active; clicked => { root.clicked(); } }
}

// Drawer navigation row (Kizzy drawer item: 20sp Semibold, 28 icon)
component DrawerRow inherits Rectangle {
    in property<string> label;
    in property<string> icon;
    in property<string> page;
    in-out property<string> current-page;
    callback navigate(string);
    height: 54px;
    border-radius: 12px;
    background: root.current-page == root.page ? AppTheme.secondary-container : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: root.icon; color: AppTheme.secondary; font-size: 22px; width: 28px; vertical-alignment: center; }
        Text { text: root.label; color: AppTheme.on-surface; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    TouchArea { clicked => { root.navigate(root.page); } }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "Music Presence";
    preferred-width: 560px;
    preferred-height: 880px;
    min-width: 420px;
    min-height: 600px;
    background: AppTheme.background;

    // ---- connection / activity (Rust contract) ----
    in-out property<string> application-id: "1571063796418744412";
    in-out property<string> rpc-mode: "Custom RPC";
    in-out property<string> activity-name: "Music Presence";
    in-out property<string> activity-details: "Listening to music";
    in-out property<string> activity-state: "";
    in-out property<string> activity-type: "Listening";
    in-out property<string> status-display-type: "Name";
    in-out property<string> media-title: "";
    in-out property<string> media-artist: "";
    in-out property<string> media-album: "";
    in-out property<string> media-kind: "Song";
    in-out property<string> media-duration: "";
    in-out property<string> media-position: "";
    in-out property<bool> media-playing: true;
    in-out property<string> large-image: "";
    in-out property<string> large-text: "";
    in-out property<string> details-url: "";
    in-out property<string> state-url: "";
    in-out property<string> large-url: "";
    in-out property<string> small-url: "";
    in-out property<string> button1-label: "";
    in-out property<string> button1-url: "";
    in-out property<string> button2-label: "";
    in-out property<string> button2-url: "";
    in-out property<string> connection-status: "Disconnected";
    in-out property<bool> connected: false;
    in-out property<bool> connecting: false;
    in-out property<string> gateway-token: "";
    in-out property<bool> remember-gateway-token: false;
    in-out property<string> gateway-status: "Not logged in";
    in-out property<bool> gateway-connected: false;
    in-out property<bool> gateway-connecting: false;
    in-out property<int> connection-method-index: 0;
    in-out property<string> oauth-status: "Not signed in";
    in-out property<bool> oauth-connected: false;
    in-out property<bool> oauth-connecting: false;
    in-out property<bool> oauth-has-session: false;
    in-out property<string> oauth-authorize-url: "";
    in-out property<string> current-page: "Home";
    in-out property<bool> drawer-open: false;
    in-out property<bool> oauth-profile-loaded: false;
    in-out property<string> oauth-display-name: "";
    in-out property<string> oauth-username: "";
    in-out property<string> oauth-user-id: "";
    in-out property<string> oauth-initials: "";
    in-out property<string> oauth-bio: "";
    in-out property<color> oauth-accent-color: #232428;
    in-out property<string> oauth-profile-art-status: "";
    in-out property<bool> oauth-has-avatar: false;
    in-out property<bool> oauth-has-banner: false;
    in-out property<image> oauth-avatar;
    in-out property<image> oauth-banner;
    in-out property<string> scrobble-lastfm-api-key: "";
    in-out property<string> scrobble-lastfm-api-secret: "";
    in-out property<bool> scrobble-lastfm-connected: false;
    in-out property<bool> scrobble-lastfm-busy: false;
    in-out property<bool> scrobble-lastfm-pending: false;
    in-out property<string> scrobble-lastfm-status: "Not connected";
    in-out property<string> scrobble-listenbrainz-token: "";
    in-out property<bool> scrobble-listenbrainz-connected: false;
    in-out property<bool> scrobble-listenbrainz-busy: false;
    in-out property<string> scrobble-listenbrainz-status: "Not connected";
    in-out property<string> scrobble-librefm-api-key: "";
    in-out property<string> scrobble-librefm-api-secret: "";
    in-out property<bool> scrobble-librefm-connected: false;
    in-out property<bool> scrobble-librefm-busy: false;
    in-out property<bool> scrobble-librefm-pending: false;
    in-out property<string> scrobble-librefm-status: "Not connected";

    // ---- detection ----
    in-out property<string> media-source: "";
    in-out property<string> detected-app: "";
    in-out property<string> detected-site: "";
    in-out property<string> media-video-url: "";
    in-out property<string> media-channel-url: "";
    in-out property<string> detection-status: "Idle — press Detect now";
    in-out property<bool> detecting: false;
    in-out property<bool> auto-detect: false;
    in-out property<bool> detect-native: true;
    in-out property<bool> detect-browser: true;
    in-out property<bool> detect-players: true;
    in-out property<string> media-activity-type: "Auto";
    in-out property<bool> media-show-album: true;
    in-out property<bool> media-hide-paused: false;
    in-out property<bool> rpc-media-enabled: false;
    in-out property<bool> media-show-artist: true;
    in-out property<bool> media-cover-art: true;
    in-out property<bool> media-app-icon: false;
    in-out property<bool> media-timestamps: true;
    in-out property<bool> media-playback-state: false;
    in-out property<bool> media-song-as-title: true;
    in-out property<bool> media-auto-activity-type: true;
    in-out property<bool> rpc-manual-enabled: false;
    in-out property<bool> rpc-custom-enabled: false;
    in-out property<string> rpc-mode-status: "All RPC modes off";
    in-out property<string> custom-name: "Music Presence";
    in-out property<string> custom-details: "";
    in-out property<string> custom-state: "";
    in-out property<string> custom-activity-type: "Listening";
    in-out property<string> custom-large-image: "";
    in-out property<string> custom-large-text: "";
    in-out property<string> custom-details-url: "";
    in-out property<string> custom-state-url: "";
    in-out property<string> custom-large-url: "";
    in-out property<string> custom-button1-label: "";
    in-out property<string> custom-button1-url: "";
    in-out property<string> custom-button2-label: "";
    in-out property<string> custom-button2-url: "";

    // ---- callbacks (Rust contract) ----
    callback connect-requested();
    callback disconnect-requested();
    callback presence-update-requested();
    callback generate-youtube-music-link();
    callback gateway-login-requested();
    callback gateway-logout-requested();
    callback oauth-login-requested();
    callback oauth-logout-requested();
    callback oauth-cancel-requested();
    callback oauth-open-authorize-url-requested();
    callback scrobble-lastfm-authorize-requested();
    callback scrobble-lastfm-finish-requested();
    callback scrobble-lastfm-disconnect-requested();
    callback scrobble-listenbrainz-save-requested();
    callback scrobble-listenbrainz-disconnect-requested();
    callback scrobble-librefm-authorize-requested();
    callback scrobble-librefm-finish-requested();
    callback scrobble-librefm-disconnect-requested();
    callback detect-now-requested();
    callback auto-detect-changed(bool);
    callback detector-settings-changed();
    callback open-url-requested(string);
    callback rpc-mode-toggled(string, bool);
    callback custom-presence-update-requested();

    function navigate(page: string) { root.current-page = page; }
    function openDrawer() { root.drawer-open = true; }

    // =========================== CONTENT ===========================
    VerticalLayout {
        // ---- Large top app bar (Home) ----
        if root.current-page == "Home": Rectangle {
            height: 118px;
            background: AppTheme.background;
            HorizontalLayout {
                padding-left: 0px;
                padding-right: 12px;
                padding-top: 4px;
                spacing: 8px;
                Rectangle {
                    width: 52px; height: 52px;
                    Text { text: "☰"; color: AppTheme.on-surface; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.openDrawer(); } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    Text {
                        text: AppLocalization.translate(AppLocalization.current_locale, "Welcome") + (root.oauth-display-name.is-empty ? "" : ", " + root.oauth-display-name);
                        color: AppTheme.on-surface;
                        font-size: 28px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 24px; height: 24px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: AppTheme.red; x: 14px; y: 0px; }
                    Text { text: "↻"; color: AppTheme.on-surface; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.navigate("Connections"); } }
                }
                Rectangle {
                    width: 44px; height: 44px; border-radius: 22px;
                    border-width: 2px; border-color: AppTheme.secondary-container;
                    clip: true;
                    background: AppTheme.secondary-container;
                    if root.oauth-has-avatar: Image { source: root.oauth-avatar; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                    if !root.oauth-has-avatar: Text { text: root.oauth-initials.is-empty ? "?" : root.oauth-initials; color: AppTheme.on-surface; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.navigate("Profile"); } }
                }
            }
        }

        // ---- Standard app bar with back button ----
        if root.current-page != "Home": Rectangle {
            height: 56px;
            background: AppTheme.background;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 12px;
                spacing: 8px;
                Rectangle {
                    width: 48px; height: 48px;
                    Text { text: "←"; color: AppTheme.on-surface; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.navigate("Home"); } }
                }
                Text {
                    text: root.current-page == "Media" ? AppLocalization.translate(AppLocalization.current_locale, "Media RPC")
                        : root.current-page == "Activity" ? AppLocalization.translate(AppLocalization.current_locale, "Manual RPC")
                        : root.current-page == "Custom" ? AppLocalization.translate(AppLocalization.current_locale, "Custom RPC")
                        : root.current-page == "Apps" ? AppLocalization.translate(AppLocalization.current_locale, "App Detection")
                        : root.current-page == "Connections" ? AppLocalization.translate(AppLocalization.current_locale, "RPC Settings")
                        : root.current-page == "Profile" ? AppLocalization.translate(AppLocalization.current_locale, "Profile")
                        : root.current-page == "Scrobbling" ? AppLocalization.translate(AppLocalization.current_locale, "Scrobbling")
                        : root.current-page == "Logs" ? AppLocalization.translate(AppLocalization.current_locale, "Logs")
                        : AppLocalization.translate(AppLocalization.current_locale, "Settings");
                    color: AppTheme.on-surface;
                    font-size: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.current-page == "Media" || root.current-page == "Apps" || root.current-page == "Logs": Rectangle {
                    width: 40px; height: 40px;
                    Text { text: "⌕"; color: AppTheme.on-surface; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            VerticalLayout {
                padding: 12px;
                padding-bottom: 24px;
                spacing: 12px;

                // ===================== HOME =====================
                if root.current-page == "Home": VerticalLayout {
                    spacing: 12px;
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Features"); }
                    FeatureCard {
                        icon: @image-url("icons/ic_media_rpc.svg");
                        title: AppLocalization.translate(AppLocalization.current_locale, "Media RPC");
                        page: "Media"; current-page <=> root.current-page;
                        checked <=> root.rpc-media-enabled;
                        toggled(v) => { root.rpc-mode-toggled("Media", v); }
                        navigate(p) => { root.navigate(p); }
                    }
                    FeatureCard {
                        icon: @image-url("icons/ic_dev_rpc.svg");
                        title: AppLocalization.translate(AppLocalization.current_locale, "Manual RPC");
                        page: "Activity"; current-page <=> root.current-page;
                        checked <=> root.rpc-manual-enabled;
                        toggled(v) => { root.rpc-mode-toggled("Manual", v); }
                        navigate(p) => { root.navigate(p); }
                    }
                    FeatureCard {
                        icon: @image-url("icons/ic_rpc_placeholder.svg");
                        title: AppLocalization.translate(AppLocalization.current_locale, "Custom RPC");
                        page: "Custom"; current-page <=> root.current-page;
                        checked <=> root.rpc-custom-enabled;
                        toggled(v) => { root.rpc-mode-toggled("Custom", v); }
                        navigate(p) => { root.navigate(p); }
                    }
                    Text {
                        text: root.rpc-mode-status;
                        color: AppTheme.on-surface-variant;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                // ===================== MEDIA RPC =====================
                if root.current-page == "Media": VerticalLayout {
                    spacing: 10px;
                    SwitchBar {
                        title: AppLocalization.translate(AppLocalization.current_locale, "Enable Media RPC");
                        checked <=> root.rpc-media-enabled;
                        toggled => { root.rpc-mode-toggled("Media", root.rpc-media-enabled); }
                    }
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "⧉"; color: AppTheme.primary; font-size: 20px; vertical-alignment: center; }
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Copy to Custom RPC"); color: AppTheme.primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => {
                            root.custom-name = root.activity-name;
                            root.custom-details = root.media-title;
                            root.custom-state = root.media-artist;
                            root.custom-large-image = root.large-image;
                            root.custom-button1-url = root.media-video-url;
                            root.custom-button2-url = root.media-channel-url;
                        } }
                    }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Media RPC"); }
                    PreferenceSwitch { title: "Show Artist Name"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-show-artist; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Show Album Name"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-show-album; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Show Cover Art"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-cover-art; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Enable Timestamps"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-timestamps; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Show Playback State"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-playback-state; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Hide RPC on Pause"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-hide-paused; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Show Song as Title"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-song-as-title; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Auto-detect activity type"; icon: @image-url("icons/ic_media_rpc.svg"); checked <=> root.media-auto-activity-type; toggled => { root.detector-settings-changed(); } }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Detection"); }
                    SwitchBar { title: "Auto-detect"; checked <=> root.auto-detect; toggled => { root.auto-detect-changed(root.auto-detect); } }
                    PreferenceSwitch { title: "Native Now Playing"; checked <=> root.detect-native; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Browser Tabs"; checked <=> root.detect-browser; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Media Players"; checked <=> root.detect-players; toggled => { root.detector-settings-changed(); } }
                    Card {
                        VerticalLayout { spacing: 6px;
                            Text { text: root.media-title.is-empty ? "—" : root.media-title; color: AppTheme.on-surface; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                            Text { text: root.media-artist; color: AppTheme.on-surface-variant; font-size: 14px; wrap: word-wrap; }
                            Text { text: root.detection-status; color: AppTheme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                            GhostButton { label: "Detect now"; active: !root.detecting; clicked => { root.detect-now-requested(); } }
                        }
                    }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Type"); }
                    HorizontalLayout {
                        spacing: 8px;
                        GhostButton { label: "Auto"; active: root.media-activity-type == "Auto"; clicked => { root.media-activity-type = "Auto"; root.detector-settings-changed(); } }
                        GhostButton { label: "Listening"; active: root.media-activity-type == "Listening"; clicked => { root.media-activity-type = "Listening"; root.detector-settings-changed(); } }
                        GhostButton { label: "Watching"; active: root.media-activity-type == "Watching"; clicked => { root.media-activity-type = "Watching"; root.detector-settings-changed(); } }
                    }
                }

                // ===================== MANUAL RPC =====================
                if root.current-page == "Activity": VerticalLayout {
                    spacing: 10px;
                    SwitchBar {
                        title: AppLocalization.translate(AppLocalization.current_locale, "Enable Manual RPC");
                        checked <=> root.rpc-manual-enabled;
                        toggled => { root.rpc-mode-toggled("Manual", root.rpc-manual-enabled); }
                    }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Advanced Settings"); }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Name"); value <=> root.activity-name; placeholder: "Music Presence"; }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Details"); value <=> root.activity-details; placeholder: "Listening to music"; }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity State"); value <=> root.activity-state; placeholder: "Artist · Album"; }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "RPC buttons"); }
                    RpcField { label: "Button 1 text"; value <=> root.button1-label; placeholder: "Open"; }
                    RpcField { label: "Button 1 URL"; value <=> root.button1-url; placeholder: "https://…"; }
                    RpcField { label: "Button 2 text"; value <=> root.button2-label; placeholder: "Channel"; }
                    RpcField { label: "Button 2 URL"; value <=> root.button2-url; placeholder: "https://…"; }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Field URLs"); }
                    RpcField { label: "Details URL"; value <=> root.details-url; placeholder: "https://…"; }
                    RpcField { label: "State URL"; value <=> root.state-url; placeholder: "https://…"; }
                    RpcField { label: "Large URL"; value <=> root.large-url; placeholder: "https://…"; }
                    RpcField { label: "Small URL"; value <=> root.small-url; placeholder: "https://…"; }
                    AccentButton { label: AppLocalization.translate(AppLocalization.current_locale, "Update presence"); active: root.connected || root.gateway-connected; clicked => { root.presence-update-requested(); } }
                }

                // ===================== CUSTOM RPC =====================
                if root.current-page == "Custom": VerticalLayout {
                    spacing: 10px;
                    SwitchBar {
                        title: AppLocalization.translate(AppLocalization.current_locale, "Enable Custom RPC");
                        checked <=> root.rpc-custom-enabled;
                        toggled => { root.rpc-mode-toggled("Custom", root.rpc-custom-enabled); }
                    }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Name"); value <=> root.custom-name; placeholder: "Music Presence"; }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Details"); value <=> root.custom-details; placeholder: "Listening to music"; }
                    RpcField { label: AppLocalization.translate(AppLocalization.current_locale, "Activity State"); value <=> root.custom-state; placeholder: "Artist · Album"; }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Activity Type"); }
                    HorizontalLayout {
                        spacing: 8px;
                        GhostButton { label: "Playing"; active: root.custom-activity-type == "Playing"; clicked => { root.custom-activity-type = "Playing"; } }
                        GhostButton { label: "Listening"; active: root.custom-activity-type == "Listening"; clicked => { root.custom-activity-type = "Listening"; } }
                        GhostButton { label: "Watching"; active: root.custom-activity-type == "Watching"; clicked => { root.custom-activity-type = "Watching"; } }
                        GhostButton { label: "Competing"; active: root.custom-activity-type == "Competing"; clicked => { root.custom-activity-type = "Competing"; } }
                    }
                    RpcField { label: "Activity Large Image"; value <=> root.custom-large-image; placeholder: "asset key or URL"; }
                    RpcField { label: "Activity Large Text"; value <=> root.custom-large-text; placeholder: "hover text"; }
                    RpcField { label: "Details URL"; value <=> root.custom-details-url; placeholder: "https://…"; }
                    RpcField { label: "State URL"; value <=> root.custom-state-url; placeholder: "https://…"; }
                    RpcField { label: "Large URL"; value <=> root.custom-large-url; placeholder: "https://…"; }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "RPC buttons"); }
                    RpcField { label: "Button 1 text"; value <=> root.custom-button1-label; placeholder: "Open"; }
                    RpcField { label: "Button 1 URL"; value <=> root.custom-button1-url; placeholder: "https://…"; }
                    RpcField { label: "Button 2 text"; value <=> root.custom-button2-label; placeholder: "Channel"; }
                    RpcField { label: "Button 2 URL"; value <=> root.custom-button2-url; placeholder: "https://…"; }
                    AccentButton { label: "Apply custom presence"; clicked => { root.custom-presence-update-requested(); } }
                }

                // ===================== APP DETECTION =====================
                if root.current-page == "Apps": VerticalLayout {
                    spacing: 10px;
                    SwitchBar { title: "Enable App Detection"; checked <=> root.auto-detect; toggled => { root.auto-detect-changed(root.auto-detect); } }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Detection sources"); }
                    PreferenceSwitch { title: "Native Now Playing"; description: "Now Playing / SMTC / MPRIS"; checked <=> root.detect-native; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Browser Tabs"; description: "YouTube, Vimeo, Twitch, Spotify"; checked <=> root.detect-browser; toggled => { root.detector-settings-changed(); } }
                    PreferenceSwitch { title: "Media Players"; description: "Spotify, Apple Music, iTunes"; checked <=> root.detect-players; toggled => { root.detector-settings-changed(); } }
                }

                // ===================== CONNECTIONS =====================
                if root.current-page == "Connections": VerticalLayout {
                    spacing: 10px;
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Discord Desktop"); }
                    RpcField { label: "Application ID"; value <=> root.application-id; placeholder: "Numeric Application ID"; enabled: !root.connected && !root.connecting; }
                    HorizontalLayout {
                        spacing: 8px;
                        if !root.connected && !root.connecting: AccentButton { label: AppLocalization.translate(AppLocalization.current_locale, "Connect"); clicked => { root.connecting = true; root.connection-status = "Connecting…"; root.connect-requested(); } }
                        if root.connected: GhostButton { label: AppLocalization.translate(AppLocalization.current_locale, "Disconnect"); clicked => { root.connecting = true; root.connection-status = "Disconnecting…"; root.disconnect-requested(); } }
                    }
                    Text { text: root.connection-status; color: AppTheme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Discord OAuth2"); }
                    GhostButton { label: AppLocalization.translate(AppLocalization.current_locale, "Login with Discord"); active: !root.oauth-connected; clicked => { root.navigate("Profile"); } }
                    SubtitleText { label: AppLocalization.translate(AppLocalization.current_locale, "Bot Gateway"); }
                    RpcField { label: "Bot token"; value <=> root.gateway-token; secret: true; placeholder: "Discord bot token"; enabled: !root.gateway-connected && !root.gateway-connecting; }
                    PreferenceSwitch { title: "Remember bot token"; checked <=> root.remember-gateway-token; toggled => {} }
                    HorizontalLayout {
                        spacing: 8px;
                        if !root.gateway-connected && !root.gateway-connecting: AccentButton { label: "Login"; clicked => { root.gateway-connecting = true; root.gateway-status = "Connecting…"; root.gateway-login-requested(); } }
                        if root.gateway-connected: GhostButton { label: "Logout"; clicked => { root.gateway-connecting = true; root.gateway-status = "Logging out…"; root.gateway-logout-requested(); } }
                    }
                    Text { text: root.gateway-status; color: AppTheme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                }

                // ===================== PROFILE =====================
                if root.current-page == "Profile": VerticalLayout {
                    spacing: 12px;
                    if !root.oauth-profile-loaded: Card {
                        VerticalLayout { spacing: 10px;
                            Text { text: "Discord Login"; color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            AccentButton { label: AppLocalization.translate(AppLocalization.current_locale, "Login with Discord"); active: !root.oauth-connected; clicked => { root.oauth-connecting = true; root.oauth-status = "Opening browser…"; root.oauth-login-requested(); } }
                            if root.oauth-connecting: GhostButton { label: "Cancel"; clicked => { root.oauth-cancel-requested(); } }
                            if root.oauth-connecting && root.oauth-authorize-url != "": GhostButton { label: "Open sign-in link"; clicked => { root.oauth-open-authorize-url-requested(); } }
                            if root.oauth-has-session && !root.oauth-connecting: GhostButton { label: "Log Out"; clicked => { root.oauth-connecting = true; root.oauth-status = "Signing out…"; root.oauth-logout-requested(); } }
                            Text { text: root.oauth-status; color: AppTheme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                            RpcField { label: "Application ID"; value <=> root.application-id; placeholder: "Numeric Application ID"; }
                        }
                    }
                    if root.oauth-profile-loaded: VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 188px;
                            background: AppTheme.surface-high;
                            Rectangle {
                                y: 0px; width: 100%; height: 140px;
                                background: root.oauth-accent-color;
                                if root.oauth-has-banner: Image { source: root.oauth-banner; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                            }
                            Rectangle {
                                x: 20px; y: 92px;
                                width: 96px; height: 96px;
                                border-width: 5px; border-color: AppTheme.primary;
                                border-radius: 48px;
                                clip: true;
                                background: AppTheme.secondary-container;
                                if root.oauth-has-avatar: Image { source: root.oauth-avatar; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                if !root.oauth-has-avatar: Text { text: root.oauth-initials; color: AppTheme.on-surface; font-size: 28px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 4px;
                            Text { text: root.oauth-display-name; color: AppTheme.on-surface; font-size: 22px; font-weight: 700; }
                            Text { text: root.oauth-username; color: AppTheme.on-surface-variant; font-size: 16px; }
                            SubtitleText { label: "BIO"; }
                            Text { text: root.oauth-bio; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                        }
                        Text { text: root.oauth-profile-art-status; color: AppTheme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
                        GhostButton { label: "Log Out"; clicked => { root.oauth-connecting = true; root.oauth-status = "Signing out…"; root.oauth-logout-requested(); } }
                    }
                }

                // ===================== SCROBBLING =====================
                if root.current-page == "Scrobbling": VerticalLayout {
                    spacing: 12px;
                    Card {
                        VerticalLayout { spacing: 8px;
                            Text { text: "Last.fm"; color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            RpcField { label: "API key"; value <=> root.scrobble-lastfm-api-key; placeholder: "Last.fm API key"; enabled: !root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy; }
                            RpcField { label: "API secret"; value <=> root.scrobble-lastfm-api-secret; secret: true; placeholder: "Last.fm API secret"; enabled: !root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy; }
                            HorizontalLayout { spacing: 8px;
                                if !root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy: AccentButton { label: "Authorize"; clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-status = "Opening browser…"; root.scrobble-lastfm-authorize-requested(); } }
                                if root.scrobble-lastfm-pending && !root.scrobble-lastfm-busy: GhostButton { label: "Finish sign-in"; clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-finish-requested(); } }
                                if root.scrobble-lastfm-connected: GhostButton { label: "Disconnect"; clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-disconnect-requested(); } }
                            }
                            Text { text: root.scrobble-lastfm-status; color: AppTheme.on-surface-variant; font-size: 12px; }
                        }
                    }
                    Card {
                        VerticalLayout { spacing: 8px;
                            Text { text: "ListenBrainz"; color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            RpcField { label: "User token"; value <=> root.scrobble-listenbrainz-token; secret: true; placeholder: "listenbrainz.org/settings token"; enabled: !root.scrobble-listenbrainz-busy; }
                            HorizontalLayout { spacing: 8px;
                                if !root.scrobble-listenbrainz-busy: AccentButton { label: "Save token"; clicked => { root.scrobble-listenbrainz-busy = true; root.scrobble-listenbrainz-status = "Saving…"; root.scrobble-listenbrainz-save-requested(); } }
                                if root.scrobble-listenbrainz-connected: GhostButton { label: "Disconnect"; clicked => { root.scrobble-listenbrainz-busy = true; root.scrobble-listenbrainz-disconnect-requested(); } }
                            }
                            Text { text: root.scrobble-listenbrainz-status; color: AppTheme.on-surface-variant; font-size: 12px; }
                        }
                    }
                    Card {
                        VerticalLayout { spacing: 8px;
                            Text { text: "Libre.fm"; color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            RpcField { label: "API key"; value <=> root.scrobble-librefm-api-key; placeholder: "Libre.fm API key"; enabled: !root.scrobble-librefm-connected && !root.scrobble-librefm-busy; }
                            RpcField { label: "API secret"; value <=> root.scrobble-librefm-api-secret; secret: true; placeholder: "Libre.fm API secret"; enabled: !root.scrobble-librefm-connected && !root.scrobble-librefm-busy; }
                            HorizontalLayout { spacing: 8px;
                                if !root.scrobble-librefm-connected && !root.scrobble-librefm-busy: AccentButton { label: "Authorize"; clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-status = "Opening browser…"; root.scrobble-librefm-authorize-requested(); } }
                                if root.scrobble-librefm-pending && !root.scrobble-librefm-busy: GhostButton { label: "Finish sign-in"; clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-finish-requested(); } }
                                if root.scrobble-librefm-connected: GhostButton { label: "Disconnect"; clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-disconnect-requested(); } }
                            }
                            Text { text: root.scrobble-librefm-status; color: AppTheme.on-surface-variant; font-size: 12px; }
                        }
                    }
                }

                // ===================== LOGS =====================
                if root.current-page == "Logs": VerticalLayout {
                    spacing: 8px;
                    Card {
                        VerticalLayout { spacing: 6px;
                            Text { text: "Desktop RPC"; color: AppTheme.primary; font-size: 11px; font-weight: 700; }
                            Text { text: root.connection-status; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                            Text { text: "Bot Gateway"; color: AppTheme.primary; font-size: 11px; font-weight: 700; }
                            Text { text: root.gateway-status; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                            Text { text: "Discord OAuth2"; color: AppTheme.primary; font-size: 11px; font-weight: 700; }
                            Text { text: root.oauth-status; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                            Text { text: "Media detection"; color: AppTheme.primary; font-size: 11px; font-weight: 700; }
                            Text { text: root.detection-status; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                            Text { text: "Scrobbling"; color: AppTheme.primary; font-size: 11px; font-weight: 700; }
                            Text { text: root.scrobble-lastfm-status + " · " + root.scrobble-listenbrainz-status + " · " + root.scrobble-librefm-status; color: AppTheme.on-surface; font-size: 14px; wrap: word-wrap; }
                        }
                    }
                }

                // ===================== SETTINGS =====================
                if root.current-page == "Settings": VerticalLayout {
                    spacing: 12px;
                    Card {
                        VerticalLayout { spacing: 10px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Display"); color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            HorizontalLayout { spacing: 8px;
                                GhostButton { label: "☾ Dark"; active: AppTheme.dark; clicked => { AppTheme.dark = true; } }
                                GhostButton { label: "☀ Light"; active: !AppTheme.dark; clicked => { AppTheme.dark = false; } }
                            }
                        }
                    }
                    Card {
                        VerticalLayout { spacing: 8px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Language"); color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            ComboBox {
                                model: AppLocalization.language_options;
                                current-value <=> AppLocalization.selected_language;
                                selected(value) => { AppLocalization.language_selected(value); }
                            }
                            GhostButton { label: "Reset to English"; clicked => { AppLocalization.language_selected("English"); } }
                        }
                    }
                    Card {
                        VerticalLayout { spacing: 8px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "About"); color: AppTheme.on-surface; font-size: 20px; font-weight: 700; }
                            Text { text: "Music Presence — a desktop reproduction of Kizzy Enhanced."; color: AppTheme.on-surface-variant; font-size: 14px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }

    // =========================== DRAWER ===========================
    if root.drawer-open: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.drawer-open = false; } }
        Rectangle {
            x: 0; y: 0;
            width: 300px;
            height: 100%;
            background: AppTheme.surface;
            VerticalLayout {
                padding: 15px;
                spacing: 5px;
                HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    Text { text: "Kizzy"; color: AppTheme.on-surface; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                    Text { text: "Enhanced"; color: AppTheme.on-surface; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                }
                DrawerRow { icon: "◐"; label: AppLocalization.translate(AppLocalization.current_locale, "Display"); page: "Settings"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                DrawerRow { icon: "文"; label: AppLocalization.translate(AppLocalization.current_locale, "Language"); page: "Settings"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                DrawerRow { icon: "≡"; label: AppLocalization.translate(AppLocalization.current_locale, "Logs"); page: "Logs"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                DrawerRow { icon: "⚙"; label: AppLocalization.translate(AppLocalization.current_locale, "Settings"); page: "Connections"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                Rectangle { height: 1px; background: AppTheme.outline; }
                SubtitleText { label: "HELP"; }
                DrawerRow { icon: "?"; label: "FAQ"; page: "Settings"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                DrawerRow { icon: "ⓘ"; label: AppLocalization.translate(AppLocalization.current_locale, "About"); page: "Settings"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                DrawerRow { icon: "★"; label: "Kizzy Quickie"; page: "Apps"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); root.drawer-open = false; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 70px;
                    border-radius: 15px;
                    background: AppTheme.secondary-container;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        Rectangle {
                            width: 50px; height: 50px; border-radius: 25px;
                            clip: true; background: AppTheme.primary;
                            if root.oauth-has-avatar: Image { source: root.oauth-avatar; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                            if !root.oauth-has-avatar: Text { text: root.oauth-initials.is-empty ? "?" : root.oauth-initials; color: AppTheme.on-primary; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: root.oauth-display-name.is-empty ? "Music Presence" : root.oauth-display-name; color: AppTheme.on-secondary-container; font-size: 20px; font-weight: 600; overflow: elide; }
                            Text { text: root.oauth-username.is-empty ? "Not signed in" : root.oauth-username; color: AppTheme.on-secondary-container; font-size: 14px; overflow: elide; }
                        }
                    }
                    TouchArea { clicked => { root.navigate("Profile"); root.drawer-open = false; } }
                }
            }
        }
    }
}
