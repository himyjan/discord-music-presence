// Music Presence — Discord-branded desktop UI.
// Palette mirrors Discord's own dark/light surfaces (see discord.com/branding)
// and the tokens shipped with Kizzy Enhanced.

import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme tokens
// ---------------------------------------------------------------------------
global AppTheme {
    in-out property<bool> dark: true;

    // Surfaces
    out property<color> bg: root.dark ? #313338 : #ffffff;
    out property<color> sidebar: root.dark ? #2b2d31 : #f2f3f5;
    out property<color> topbar: root.dark ? #313338 : #ffffff;
    out property<color> card: root.dark ? #232428 : #f2f3f5;
    out property<color> card-hover: root.dark ? #2e3035 : #e3e5e8;
    out property<color> input: root.dark ? #1e1f22 : #ffffff;
    out property<color> border: root.dark ? #3f4147 : #d9dadd;
    out property<color> track: root.dark ? #3f4147 : #d9dadd;

    // Text
    out property<color> text: root.dark ? #f2f3f5 : #2e3338;
    out property<color> muted: root.dark ? #b5bac1 : #4e5058;
    out property<color> subtle: root.dark ? #949ba4 : #6d6f78;

    // Brand / status
    out property<color> accent: #5865f2;
    out property<color> accent-hover: #4752c4;
    out property<color> green: root.dark ? #23a55a : #248046;
    out property<color> yellow: root.dark ? #f0b232 : #c8912b;
    out property<color> red: root.dark ? #f23f43 : #da373c;
    out property<color> on-brand: #ffffff;
}

export global AppLocalization {
    in property <[string]> language_options: [];
    in-out property <string> selected_language: "English";
    in-out property <string> current_locale: "";
    callback language_selected(string);
    pure callback translate(string, string) -> string;
}

// ---------------------------------------------------------------------------
// Reusable pieces
// ---------------------------------------------------------------------------
component NavItem inherits Rectangle {
    in property<string> label;
    in property<string> icon;
    in property<string> page;
    in-out property<string> current-page;
    callback navigate(string);

    height: 42px;
    border-radius: 8px;
    background: root.current-page == root.page
        ? (AppTheme.dark ? #404249 : #e3e5e8)
        : transparent;

    HorizontalLayout {
        spacing: 12px;
        padding-left: 12px;
        padding-right: 8px;
        Text {
            text: root.icon;
            color: root.current-page == root.page ? AppTheme.text : AppTheme.muted;
            font-size: 17px;
            width: 22px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.current-page == root.page ? AppTheme.text : AppTheme.muted;
            font-size: 14px;
            font-weight: root.current-page == root.page ? 600 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.navigate(root.page); }
    }
}

component PrimaryButton inherits Rectangle {
    in property<string> label;
    in property<bool> active: true;
    callback clicked();
    height: 38px;
    min-width: 120px;
    border-radius: 8px;
    background: root.active ? AppTheme.accent : AppTheme.track;
    Text {
        text: root.label;
        color: root.active ? AppTheme.on-brand : AppTheme.subtle;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
}

component SecondaryButton inherits Rectangle {
    in property<string> label;
    in property<bool> active: true;
    callback clicked();
    height: 38px;
    min-width: 96px;
    border-radius: 8px;
    background: root.active ? AppTheme.card-hover : transparent;
    border-width: 1px;
    border-color: AppTheme.border;
    Text {
        text: root.label;
        color: root.active ? AppTheme.text : AppTheme.subtle;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
}

component Switch inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    callback toggled();
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: !root.enabled ? AppTheme.border : (root.checked ? AppTheme.accent : AppTheme.track);
    Rectangle {
        x: root.checked ? 23px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: AppTheme.on-brand;
        animate x { duration: 120ms; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(); }
    }
}

component ToggleRow inherits Rectangle {
    in property<string> title;
    in property<string> subtitle;
    in-out property<bool> checked;
    in property<bool> enabled: true;
    callback toggled();
    height: root.subtitle.is-empty ? 46px : 62px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.enabled ? AppTheme.text : AppTheme.subtle;
                font-size: 14px;
                font-weight: 500;
                vertical-alignment: center;
            }
            if !root.subtitle.is-empty: Text {
                text: root.subtitle;
                color: AppTheme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        Switch {
            checked <=> root.checked;
            enabled: root.enabled;
            toggled => { root.toggled(); }
        }
    }
}

component Card inherits Rectangle {
    in property<length> card-padding: 18px;
    background: AppTheme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: AppTheme.border;
    VerticalLayout {
        padding: root.card-padding;
        spacing: 12px;
        @children
    }
}

component Field inherits VerticalLayout {
    in property<string> label;
    in-out property<string> value;
    in property<string> placeholder;
    in property<bool> secret: false;
    in property<bool> enabled: true;
    spacing: 6px;
    Text {
        text: root.label;
        color: AppTheme.muted;
        font-size: 12px;
        font-weight: 600;
    }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        enabled: root.enabled;
        input-type: root.secret ? InputType.password : InputType.text;
    }
}

component FeatureCard inherits Rectangle {
    in property<string> icon;
    in property<string> title;
    in property<string> description;
    in property<string> page;
    in-out property<string> current-page;
    callback navigate(string);
    height: 132px;
    border-radius: 14px;
    background: AppTheme.card;
    border-width: 1px;
    border-color: AppTheme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        Text { text: root.icon; color: AppTheme.accent; font-size: 24px; }
        Text { text: root.title; color: AppTheme.text; font-size: 16px; font-weight: 700; }
        Text {
            text: root.description;
            color: AppTheme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    TouchArea {
        clicked => { root.navigate(root.page); }
    }
}

component RpcFeatureCard inherits Rectangle {
    in property<string> icon;
    in property<string> title;
    in property<string> description;
    in property<string> page;
    in-out property<string> current-page;
    in-out property<bool> checked;
    callback navigate(string);
    callback toggled(bool);
    height: 118px;
    border-radius: 14px;
    background: AppTheme.card;
    border-width: 1px;
    border-color: root.checked ? AppTheme.accent : AppTheme.border;
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        Rectangle {
            width: 46px; height: 46px; border-radius: 12px;
            background: root.checked ? AppTheme.accent : AppTheme.card-hover;
            Text { text: root.icon; color: root.checked ? AppTheme.on-brand : AppTheme.accent; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.title; color: AppTheme.text; font-size: 15px; font-weight: 700; }
            Text { text: root.description; color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Open settings →"); color: AppTheme.accent; font-size: 11px; }
        }
        VerticalLayout {
            width: 48px;
            alignment: center;
            Switch {
                checked <=> root.checked;
                toggled => { root.toggled(root.checked); }
            }
        }
    }
    TouchArea {
        clicked => { root.navigate(root.page); }
    }
}

component StatusPill inherits Rectangle {
    in property<string> label;
    in property<color> dot;
    height: 26px;
    border-radius: 13px;
    background: AppTheme.card-hover;
    HorizontalLayout {
        spacing: 8px;
        padding-left: 10px;
        padding-right: 10px;
        Rectangle {
            width: 8px; height: 8px; border-radius: 4px;
            background: root.dot;
        }
        Text {
            text: root.label;
            color: AppTheme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: AppLocalization.translate(AppLocalization.current_locale, "Music Presence");
    icon: @image-url("../packaging/music-presence.svg");
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 880px;
    min-height: 620px;
    background: AppTheme.bg;

    // ---- persisted / shared state (kept for Rust workers) ----
    in-out property<string> application-id: "1571063796418744412";
    in-out property<string> rpc-mode: "Custom RPC";
    in-out property<string> activity-name: "Music Presence";
    in-out property<string> activity-details: "Listening to music";
    in-out property<string> activity-state: "";
    in-out property<string> activity-type: "Listening";
    in-out property<string> status-display-type: "Name";
    in-out property<string> media-title: AppLocalization.translate(AppLocalization.current_locale, "");
    in-out property<string> media-artist: "";
    in-out property<string> media-album: "";
    in-out property<string> media-kind: "Song";
    in-out property<string> media-duration: "";
    in-out property<string> media-position: "";
    in-out property<bool> media-playing: true;
    in-out property<string> large-image: "";
    in-out property<string> large-text: AppLocalization.translate(AppLocalization.current_locale, "");
    in-out property<string> details-url: "";
    in-out property<string> state-url: "";
    in-out property<string> large-url: "";
    in-out property<string> small-url: "";
    in-out property<string> button1-label: AppLocalization.translate(AppLocalization.current_locale, "");
    in-out property<string> button1-url: "";
    in-out property<string> button2-label: AppLocalization.translate(AppLocalization.current_locale, "");
    in-out property<string> button2-url: "";
    in-out property<string> connection-status: "Disconnected";
    in-out property<bool> connected: false;
    in-out property<bool> connecting: false;
    in-out property<string> gateway-token: "";
    in-out property<bool> remember-gateway-token: false;
    in-out property<string> gateway-status: "Not logged in";
    in-out property<bool> gateway-connected: false;
    in-out property<bool> gateway-connecting: false;
    in-out property<int> connection-method-index: 0;
    in-out property<string> oauth-status: "Not signed in";
    in-out property<bool> oauth-connected: false;
    in-out property<bool> oauth-connecting: false;
    in-out property<bool> oauth-has-session: false;
    in-out property<string> oauth-authorize-url: "";
    in-out property<string> current-page: "Home";
    in-out property<bool> oauth-profile-loaded: false;
    in-out property<string> oauth-display-name: "";
    in-out property<string> oauth-username: "";
    in-out property<string> oauth-user-id: "";
    in-out property<string> oauth-initials: "";
    in-out property<string> oauth-bio: "";
    in-out property<color> oauth-accent-color: #232428;
    in-out property<string> oauth-profile-art-status: "";
    in-out property<bool> oauth-has-avatar: false;
    in-out property<bool> oauth-has-banner: false;
    in-out property<image> oauth-avatar;
    in-out property<image> oauth-banner;
    in-out property<string> scrobble-lastfm-api-key: "";
    in-out property<string> scrobble-lastfm-api-secret: "";
    in-out property<bool> scrobble-lastfm-connected: false;
    in-out property<bool> scrobble-lastfm-busy: false;
    in-out property<bool> scrobble-lastfm-pending: false;
    in-out property<string> scrobble-lastfm-status: "Not connected";
    in-out property<string> scrobble-listenbrainz-token: "";
    in-out property<bool> scrobble-listenbrainz-connected: false;
    in-out property<bool> scrobble-listenbrainz-busy: false;
    in-out property<string> scrobble-listenbrainz-status: "Not connected";
    in-out property<string> scrobble-librefm-api-key: "";
    in-out property<string> scrobble-librefm-api-secret: "";
    in-out property<bool> scrobble-librefm-connected: false;
    in-out property<bool> scrobble-librefm-busy: false;
    in-out property<bool> scrobble-librefm-pending: false;
    in-out property<string> scrobble-librefm-status: "Not connected";

    // ---- auto-detection state ----
    in-out property<string> media-source: "";
    in-out property<string> detected-app: "";
    in-out property<string> detected-site: "";
    in-out property<string> media-video-url: "";
    in-out property<string> media-channel-url: "";
    in-out property<string> detection-status: "Idle — press Detect now";
    in-out property<bool> detecting: false;
    in-out property<bool> auto-detect: false;
    in-out property<bool> detect-native: true;
    in-out property<bool> detect-browser: true;
    in-out property<bool> detect-players: true;
    in-out property<string> media-activity-type: "Auto";
    in-out property<bool> media-show-album: true;
    in-out property<bool> media-hide-paused: false;
    in-out property<bool> rpc-media-enabled: false;
    in-out property<bool> media-show-artist: true;
    in-out property<bool> media-cover-art: true;
    in-out property<bool> media-app-icon: false;
    in-out property<bool> media-timestamps: true;
    in-out property<bool> media-playback-state: false;
    in-out property<bool> media-song-as-title: true;
    in-out property<bool> media-auto-activity-type: true;
    in-out property<bool> rpc-manual-enabled: false;
    in-out property<bool> rpc-custom-enabled: false;
    in-out property<string> rpc-mode-status: "All RPC modes off";
    in-out property<string> custom-name: "Music Presence";
    in-out property<string> custom-details: "";
    in-out property<string> custom-state: "";
    in-out property<string> custom-activity-type: "Listening";
    in-out property<string> custom-large-image: "";
    in-out property<string> custom-large-text: "";
    in-out property<string> custom-details-url: "";
    in-out property<string> custom-state-url: "";
    in-out property<string> custom-large-url: "";
    in-out property<string> custom-button1-label: "";
    in-out property<string> custom-button1-url: "";
    in-out property<string> custom-button2-label: "";
    in-out property<string> custom-button2-url: "";

    // ---- callbacks (wired in Rust) ----
    callback connect-requested();
    callback disconnect-requested();
    callback presence-update-requested();
    callback generate-youtube-music-link();
    callback gateway-login-requested();
    callback gateway-logout-requested();
    callback oauth-login-requested();
    callback oauth-logout-requested();
    callback oauth-cancel-requested();
    callback oauth-open-authorize-url-requested();
    callback scrobble-lastfm-authorize-requested();
    callback scrobble-lastfm-finish-requested();
    callback scrobble-lastfm-disconnect-requested();
    callback scrobble-listenbrainz-save-requested();
    callback scrobble-listenbrainz-disconnect-requested();
    callback scrobble-librefm-authorize-requested();
    callback scrobble-librefm-finish-requested();
    callback scrobble-librefm-disconnect-requested();
    callback detect-now-requested();
    callback auto-detect-changed(bool);
    callback detector-settings-changed();
    callback open-url-requested(string);
    callback rpc-mode-toggled(string, bool);
    callback custom-presence-update-requested();

    // Helper: navigate + share current page with nav items.
    function navigate(page: string) {
        root.current-page = page;
    }

    HorizontalLayout {
        // ------------------------- Sidebar -------------------------
        Rectangle {
            width: 232px;
            background: AppTheme.sidebar;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        source: @image-url("../packaging/music-presence.svg");
                        width: 34px;
                        height: 34px;
                        image-fit: contain;
                    }
                    VerticalLayout {
                        spacing: 0px;
                        Text { text: AppLocalization.translate(AppLocalization.current_locale, "Music Presence"); color: AppTheme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        Text { text: AppLocalization.translate(AppLocalization.current_locale, "Rich Presence for Discord"); color: AppTheme.muted; font-size: 11px; }
                    }
                }
                Rectangle { height: 6px; }
                NavItem { icon: "⌂"; label: AppLocalization.translate(AppLocalization.current_locale, "Home"); page: "Home"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "✎"; label: AppLocalization.translate(AppLocalization.current_locale, "Manual RPC"); page: "Activity"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "◆"; label: AppLocalization.translate(AppLocalization.current_locale, "Custom RPC"); page: "Custom"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "♫"; label: AppLocalization.translate(AppLocalization.current_locale, "Media RPC"); page: "Media"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "▦"; label: AppLocalization.translate(AppLocalization.current_locale, "App Detection"); page: "Apps"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "⚡"; label: AppLocalization.translate(AppLocalization.current_locale, "Connections"); page: "Connections"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "☺"; label: AppLocalization.translate(AppLocalization.current_locale, "Profile"); page: "Profile"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "↻"; label: AppLocalization.translate(AppLocalization.current_locale, "Scrobbling"); page: "Scrobbling"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                NavItem { icon: "⚙"; label: AppLocalization.translate(AppLocalization.current_locale, "Settings"); page: "Settings"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    background: AppTheme.card;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        Text { text: AppLocalization.translate(AppLocalization.current_locale, "STATUS"); color: AppTheme.subtle; font-size: 10px; font-weight: 700; }
                        StatusPill {
                            label: root.connected
                                ? AppLocalization.translate(AppLocalization.current_locale, "Desktop RPC: Connected")
                                : AppLocalization.translate(AppLocalization.current_locale, "Desktop RPC: Offline");
                            dot: root.connected ? AppTheme.green : AppTheme.subtle;
                        }
                        StatusPill {
                            label: root.gateway-connected
                                ? AppLocalization.translate(AppLocalization.current_locale, "Bot gateway: Online")
                                : AppLocalization.translate(AppLocalization.current_locale, "Bot gateway: Offline");
                            dot: root.gateway-connected ? AppTheme.green : AppTheme.subtle;
                        }
                        StatusPill {
                            label: root.oauth-connected
                                ? AppLocalization.translate(AppLocalization.current_locale, "Discord: Signed in")
                                : AppLocalization.translate(AppLocalization.current_locale, "Discord: Not signed in");
                            dot: root.oauth-connected ? AppTheme.green : AppTheme.subtle;
                        }
                        StatusPill {
                            label: root.auto-detect
                                ? AppLocalization.translate(AppLocalization.current_locale, "Auto-detect: On")
                                : AppLocalization.translate(AppLocalization.current_locale, "Auto-detect: Off");
                            dot: root.auto-detect ? AppTheme.green : AppTheme.yellow;
                        }
                    }
                }
            }
        }

        // ------------------------- Main column -------------------------
        Rectangle {
            background: AppTheme.bg;
            VerticalLayout {
                // Top bar
                Rectangle {
                    height: 60px;
                    background: AppTheme.topbar;
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 24px; spacing: 12px;
                        Text {
                            text: root.current-page == "Home" ? AppLocalization.translate(AppLocalization.current_locale, "Overview")
                                : root.current-page == "Activity" ? AppLocalization.translate(AppLocalization.current_locale, "Manual RPC")
                                : root.current-page == "Custom" ? AppLocalization.translate(AppLocalization.current_locale, "Custom RPC")
                                : root.current-page == "Media" ? AppLocalization.translate(AppLocalization.current_locale, "Media RPC")
                                : root.current-page == "Apps" ? AppLocalization.translate(AppLocalization.current_locale, "App Detection")
                                : root.current-page == "Connections" ? AppLocalization.translate(AppLocalization.current_locale, "Connections")
                                : root.current-page == "Profile" ? AppLocalization.translate(AppLocalization.current_locale, "Discord Profile")
                                : root.current-page == "Scrobbling" ? AppLocalization.translate(AppLocalization.current_locale, "Scrobbling")
                                : AppLocalization.translate(AppLocalization.current_locale, "Settings");
                            color: AppTheme.text;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        StatusPill {
                            label: root.detecting
                                ? AppLocalization.translate(AppLocalization.current_locale, "Scanning…")
                                : (root.media-source.is-empty
                                    ? AppLocalization.translate(AppLocalization.current_locale, "No media")
                                    : root.media-source);
                            dot: root.detecting ? AppTheme.yellow : (root.media-source.is-empty ? AppTheme.subtle : AppTheme.green);
                        }
                        SecondaryButton {
                            label: AppTheme.dark
                                ? AppLocalization.translate(AppLocalization.current_locale, "☾ Dark")
                                : AppLocalization.translate(AppLocalization.current_locale, "☀ Light");
                            min-width: 104px;
                            clicked => { AppTheme.dark = !AppTheme.dark; }
                        }
                    }
                }

                // Scrolling page area
                ScrollView {
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    VerticalLayout {
                        padding: 24px;
                        padding-bottom: 40px;
                        spacing: 18px;

                        // ===================== HOME =====================
                        if (root.current-page == "Home"): VerticalLayout {
                            spacing: 18px;
                            Text { text: "Welcome" + (root.oauth-display-name.is-empty ? "" : ", " + root.oauth-display-name) + " — choose which Rich Presence modes to run."; color: AppTheme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "All three modes can be on at the same time. Discord shows the most recent update."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 14px;
                                RpcFeatureCard { icon: "♫"; title: AppLocalization.translate(AppLocalization.current_locale, "Media RPC"); description: AppLocalization.translate(AppLocalization.current_locale, "Auto-detect playing media and browser links."); page: "Media"; current-page <=> root.current-page; checked <=> root.rpc-media-enabled; toggled(v) => { root.rpc-mode-toggled("Media", v); } navigate(p) => { root.navigate(p); } }
                                RpcFeatureCard { icon: "✎"; title: AppLocalization.translate(AppLocalization.current_locale, "Manual RPC"); description: AppLocalization.translate(AppLocalization.current_locale, "Broadcast details you enter yourself."); page: "Activity"; current-page <=> root.current-page; checked <=> root.rpc-manual-enabled; toggled(v) => { root.rpc-mode-toggled("Manual", v); } navigate(p) => { root.navigate(p); } }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                RpcFeatureCard { icon: "◆"; title: AppLocalization.translate(AppLocalization.current_locale, "Custom RPC"); description: AppLocalization.translate(AppLocalization.current_locale, "Fully custom activity with assets and buttons."); page: "Custom"; current-page <=> root.current-page; checked <=> root.rpc-custom-enabled; toggled(v) => { root.rpc-mode-toggled("Custom", v); } navigate(p) => { root.navigate(p); } }
                                FeatureCard { icon: "⚡"; title: AppLocalization.translate(AppLocalization.current_locale, "Connections"); description: AppLocalization.translate(AppLocalization.current_locale, "Desktop RPC, bot gateway and OAuth sign-in."); page: "Connections"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                FeatureCard { icon: "▦"; title: AppLocalization.translate(AppLocalization.current_locale, "App Detection"); description: AppLocalization.translate(AppLocalization.current_locale, "Choose which players and browsers are used."); page: "Apps"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                                FeatureCard { icon: "↻"; title: AppLocalization.translate(AppLocalization.current_locale, "Scrobbling"); description: AppLocalization.translate(AppLocalization.current_locale, "Last.fm, ListenBrainz and Libre.fm."); page: "Scrobbling"; current-page <=> root.current-page; navigate(p) => { root.navigate(p); } }
                            }
                            Card {
                                VerticalLayout { spacing: 8px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "RPC status"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    Text { text: root.rpc-mode-status; color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Add your Application ID under Connections and connect to start broadcasting."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }

                        // ===================== ACTIVITY =====================
                        if (root.current-page == "Activity"): VerticalLayout {
                            spacing: 18px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Craft a Rich Presence by hand."); color: AppTheme.muted; font-size: 14px; }
                            Card {
                                VerticalLayout { spacing: 12px;
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Manual RPC enabled"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Run this mode independently of Media and Custom."); checked <=> root.rpc-manual-enabled; toggled => { root.rpc-mode-toggled("Manual", root.rpc-manual-enabled); } }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Activity type"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Custom RPC"); active: root.rpc-mode == "Custom RPC"; clicked => { root.rpc-mode = "Custom RPC"; } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Media RPC"); active: root.rpc-mode == "Media RPC"; clicked => { root.rpc-mode = "Media RPC"; } }
                                    }
                                    if (root.rpc-mode == "Custom RPC"): VerticalLayout {
                                        spacing: 10px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Activity name"); value <=> root.activity-name; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Music Presence"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Details"); value <=> root.activity-details; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Listening to music"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "State"); value <=> root.activity-state; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Artist · Album"); }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Playing"); active: root.activity-type == "Playing"; clicked => { root.activity-type = "Playing"; } }
                                            SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Listening"); active: root.activity-type == "Listening"; clicked => { root.activity-type = "Listening"; } }
                                            SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Watching"); active: root.activity-type == "Watching"; clicked => { root.activity-type = "Watching"; } }
                                            SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Competing"); active: root.activity-type == "Competing"; clicked => { root.activity-type = "Competing"; } }
                                        }
                                    }
                                    if (root.rpc-mode == "Media RPC"): VerticalLayout {
                                        spacing: 10px;
                                        Text { text: AppLocalization.translate(AppLocalization.current_locale, "Manual metadata (auto-detected values can overwrite these)."); color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Title"); value <=> root.media-title; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Track or video title"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Artist / channel"); value <=> root.media-artist; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Artist or channel"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Album / playlist"); value <=> root.media-album; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Album or playlist"); }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Field { label: AppLocalization.translate(AppLocalization.current_locale, "Duration (s)"); value <=> root.media-duration; placeholder: AppLocalization.translate(AppLocalization.current_locale, "0"); }
                                            Field { label: AppLocalization.translate(AppLocalization.current_locale, "Position (s)"); value <=> root.media-position; placeholder: AppLocalization.translate(AppLocalization.current_locale, "0"); }
                                        }
                                        ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Playing"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Off shows a paused state and hides the timeline."); checked <=> root.media-playing; toggled => {} }
                                    }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Artwork"); color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Large image key or image URL"); value <=> root.large-image; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Optional asset key"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Hover text"); value <=> root.large-text; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Optional"); }
                                    }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Clickable field URLs (Discord Social SDK)"); color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Makes the details line, state line and image assets clickable in Discord."); color: AppTheme.muted; font-size: 12px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Details URL"); value <=> root.details-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "State URL"); value <=> root.state-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Large image URL"); value <=> root.large-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Small image URL"); value <=> root.small-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                    }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Status text in member list"); color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Name"); active: root.status-display-type == "Name"; clicked => { root.status-display-type = "Name"; } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "State"); active: root.status-display-type == "State"; clicked => { root.status-display-type = "State"; } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Details"); active: root.status-display-type == "Details"; clicked => { root.status-display-type = "Details"; } }
                                    }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Buttons"); color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Button 1 label"); value <=> root.button1-label; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Open on YouTube"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Button 1 URL"); value <=> root.button1-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Button 2 label"); value <=> root.button2-label; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Visit channel"); }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "Button 2 URL"); value <=> root.button2-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "https://…"); }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Auto YouTube Music link"); clicked => { root.generate-youtube-music-link(); } }
                                        PrimaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Update presence"); active: root.connected || root.gateway-connected; clicked => { root.presence-update-requested(); } }
                                    }
                                }
                            }
                        }

                        // ===================== MEDIA =====================
                        if (root.current-page == "Media"): VerticalLayout {
                            spacing: 18px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Automatically broadcast what your desktop is playing."); color: AppTheme.muted; font-size: 14px; wrap: word-wrap; }
                            Card {
                                VerticalLayout { spacing: 14px;
                                    ToggleRow { title: "Media RPC enabled"; subtitle: "Run this mode independently of Manual and Custom."; checked <=> root.rpc-media-enabled; toggled => { root.rpc-mode-toggled("Media", root.rpc-media-enabled); } }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text { text: AppLocalization.translate(AppLocalization.current_locale, "Auto-detect"); color: AppTheme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Switch {
                                            checked <=> root.auto-detect;
                                            toggled => { root.auto-detect-changed(root.auto-detect); }
                                        }
                                    }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, root.detection-status); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        PrimaryButton { label: root.detecting ? AppLocalization.translate(AppLocalization.current_locale, "Scanning…") : AppLocalization.translate(AppLocalization.current_locale, "Detect now"); active: !root.detecting; clicked => { root.detect-now-requested(); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Open video"); active: !root.media-video-url.is-empty; clicked => { root.open-url-requested(root.media-video-url); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Open channel"); active: !root.media-channel-url.is-empty; clicked => { root.open-url-requested(root.media-channel-url); } }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 6px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Presence details"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    ToggleRow { title: "Show artist name"; checked <=> root.media-show-artist; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Show album name"; checked <=> root.media-show-album; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Show cover art"; subtitle: "Use detected artwork when available."; checked <=> root.media-cover-art; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Show app icon"; checked <=> root.media-app-icon; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Enable timestamps"; checked <=> root.media-timestamps; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Show playback state"; checked <=> root.media-playback-state; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Hide when paused"; checked <=> root.media-hide-paused; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Show song as title"; checked <=> root.media-song-as-title; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: "Auto activity type"; checked <=> root.media-auto-activity-type; toggled => { root.detector-settings-changed(); } }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Detection sources"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Native Now Playing"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "OS media session: Now Playing / SMTC / MPRIS."); checked <=> root.detect-native; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Browser tabs"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Foreground tab URL when available (YouTube, Vimeo, Twitch, Spotify)."); checked <=> root.detect-browser; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Media players"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Spotify, Apple Music and iTunes on macOS."); checked <=> root.detect-players; toggled => { root.detector-settings-changed(); } }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 12px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Currently detected"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    Text { text: (root.media-source.is-empty ? AppLocalization.translate(AppLocalization.current_locale, "Nothing yet") : root.media-source + (root.detected-app.is-empty ? "" : " · " + root.detected-app)); color: AppTheme.muted; font-size: 12px; }
                                    Text { text: root.media-title.is-empty ? "—" : root.media-title; color: AppTheme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: ((root.media-artist.is-empty ? "" : root.media-artist) + (root.media-album.is-empty ? "" : " · " + root.media-album)); color: AppTheme.muted; font-size: 14px; wrap: word-wrap; }
                                    Rectangle {
                                        height: 6px; border-radius: 3px; background: AppTheme.track;
                                        Rectangle {
                                            height: 6px; border-radius: 3px; background: AppTheme.accent;
                                            width: parent.width * (
                                                root.media-duration.to-float() > 0
                                                ? Math.min(1, root.media-position.to-float() / root.media-duration.to-float())
                                                : 0
                                            );
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: root.media-playing ? AppLocalization.translate(AppLocalization.current_locale, "▶ Playing") : AppLocalization.translate(AppLocalization.current_locale, "❚❚ Paused"); color: root.media-playing ? AppTheme.green : AppTheme.yellow; font-size: 12px; }
                                        Text { text: root.media-position + " / " + root.media-duration + " s"; color: AppTheme.subtle; font-size: 12px; }
                                    }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Video / track URL"); value <=> root.media-video-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Detected automatically"); }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Channel / artist URL"); value <=> root.media-channel-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Detected automatically"); }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Presence options"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Auto"); active: root.media-activity-type == "Auto"; clicked => { root.media-activity-type = "Auto"; root.detector-settings-changed(); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Listening"); active: root.media-activity-type == "Listening"; clicked => { root.media-activity-type = "Listening"; root.detector-settings-changed(); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Watching"); active: root.media-activity-type == "Watching"; clicked => { root.media-activity-type = "Watching"; root.detector-settings-changed(); } }
                                    }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Show album"); checked <=> root.media-show-album; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Hide while paused"); checked <=> root.media-hide-paused; toggled => { root.detector-settings-changed(); } }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Status text in member list"); color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Name"); active: root.status-display-type == "Name"; clicked => { root.status-display-type = "Name"; root.detector-settings-changed(); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "State"); active: root.status-display-type == "State"; clicked => { root.status-display-type = "State"; root.detector-settings-changed(); } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Details"); active: root.status-display-type == "Details"; clicked => { root.status-display-type = "Details"; root.detector-settings-changed(); } }
                                    }
                                }
                            }
                        }

                        // ===================== APPS =====================
                        if (root.current-page == "Apps"): VerticalLayout {
                            spacing: 18px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Choose which sources may update your Rich Presence."); color: AppTheme.muted; font-size: 14px; }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Detection backends"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Native Now Playing"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "macOS Now Playing, Windows SMTC, Linux MPRIS."); checked <=> root.detect-native; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Browser detection"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Chrome, Safari, Edge, Brave, Arc and Firefox."); checked <=> root.detect-browser; toggled => { root.detector-settings-changed(); } }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Player apps"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Spotify, Apple Music, iTunes (AppleScript on macOS)."); checked <=> root.detect-players; toggled => { root.detector-settings-changed(); } }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Supported media sources"); color: AppTheme.text; font-size: 16px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Spotify · Apple Music · iTunes · YouTube · YouTube Music · Vimeo · Twitch · Bilibili · SoundCloud · Any MPRIS or SMTC player"); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "A browser tab or player must be the active/playing source for URL extraction. When a full URL is not exposed, a canonical search link is generated from the window title instead."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }

                        // ===================== CONNECTIONS =====================
                        if (root.current-page == "Connections"): VerticalLayout {
                            spacing: 18px;
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Activity connection method"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Desktop Rich Presence is the default and needs no token. Bot Gateway is optional and requires a bot token."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    ComboBox {
                                        model: [
                                            AppLocalization.translate(AppLocalization.current_locale, "Discord desktop Rich Presence"),
                                            AppLocalization.translate(AppLocalization.current_locale, "Discord bot Gateway")
                                        ];
                                        current-index <=> root.connection-method-index;
                                        enabled: !root.connected && !root.connecting && !root.gateway-connected && !root.gateway-connecting;
                                    }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Discord Application ID"); value <=> root.application-id; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Numeric Discord application ID"); enabled: !root.connected && !root.connecting && !root.oauth-connecting; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "This ID is used for desktop Rich Presence and browser OAuth. Leave the default to use the built-in OAuth application."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                            if (root.connection-method-index == 0): Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Discord desktop Rich Presence"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Connects to the running Discord desktop app through local IPC. No browser login or account token is needed to publish activity."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        if (!root.connected && !root.connecting): PrimaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Connect");
                                            clicked => {
                                                root.connecting = true;
                                                root.connection-status = "Connecting…";
                                                root.connect-requested();
                                            }
                                        }
                                        if (root.connecting): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Connecting…"); active: false; clicked => {} }
                                        if (root.connected): SecondaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Disconnect");
                                            clicked => {
                                                root.connecting = true;
                                                root.connection-status = "Disconnecting…";
                                                root.disconnect-requested();
                                            }
                                        }
                                        Text { text: root.connection-status; color: root.connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                            if (root.connection-method-index == 1): Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Discord bot Gateway"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Optional bot-only connection. Browser OAuth signs in for profile details and cannot replace a bot token or change a personal account's activity."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Bot token"); value <=> root.gateway-token; secret: true; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Discord bot token"); enabled: !root.gateway-connected && !root.gateway-connecting; }
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Remember bot token (encrypted)"); checked <=> root.remember-gateway-token; toggled => {} }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        if (!root.gateway-connected && !root.gateway-connecting): PrimaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Login");
                                            clicked => {
                                                root.gateway-connecting = true;
                                                root.gateway-status = "Connecting as bot…";
                                                root.gateway-login-requested();
                                            }
                                        }
                                        if (root.gateway-connecting): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Connecting…"); active: false; clicked => {} }
                                        if (root.gateway-connected): SecondaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Logout");
                                            clicked => {
                                                root.gateway-connecting = true;
                                                root.gateway-status = "Logging out…";
                                                root.gateway-logout-requested();
                                            }
                                        }
                                        Text { text: root.gateway-status; color: root.gateway-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Discord account browser sign-in"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Opens Discord in your system browser and loads your account profile using OAuth. This is separate from the selected activity connection method."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        if (!root.oauth-has-session && !root.oauth-connecting): PrimaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Sign in with Discord");
                                            clicked => {
                                                root.oauth-connecting = true;
                                                root.oauth-status = "Opening browser…";
                                                root.oauth-login-requested();
                                            }
                                        }
                                        if (root.oauth-connecting): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Cancel"); clicked => { root.oauth-status = "Canceling…"; root.oauth-cancel-requested(); } }
                                        if (root.oauth-connecting && root.oauth-authorize-url != ""): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Open sign-in link"); clicked => { root.oauth-open-authorize-url-requested(); } }
                                        if (root.oauth-has-session && !root.oauth-connecting): SecondaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Logout");
                                            clicked => {
                                                root.oauth-connecting = true;
                                                root.oauth-status = "Signing out…";
                                                root.oauth-logout-requested();
                                            }
                                        }
                                        Text { text: root.oauth-status; color: root.oauth-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                    if (root.oauth-connecting && root.oauth-authorize-url != ""): Field { label: AppLocalization.translate(AppLocalization.current_locale, "Sign-in link"); value <=> root.oauth-authorize-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, ""); }
                                }
                            }
                        }

                        // ===================== PROFILE =====================
                        if (root.current-page == "Profile"): VerticalLayout {
                            spacing: 18px;
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Discord account"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Sign in through your browser to preview the profile fields Discord shares with the identify scope. This does not change your profile or send activity."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Application ID"); value <=> root.application-id; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Numeric Discord application ID"); enabled: !root.oauth-connecting; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Uses Kizzy Enhanced's OAuth app by default; you can enter your own Client ID. Callback: kizzy://oauth2/callback."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        if (!root.oauth-connected && !root.oauth-connecting): PrimaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Login with Discord");
                                            clicked => {
                                                root.oauth-connecting = true;
                                                root.oauth-status = "Opening browser…";
                                                root.oauth-login-requested();
                                            }
                                        }
                                        if (root.oauth-connecting): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Cancel"); clicked => { root.oauth-status = "Canceling…"; root.oauth-cancel-requested(); } }
                                        if (root.oauth-connecting && root.oauth-authorize-url != ""): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Open sign-in link"); clicked => { root.oauth-open-authorize-url-requested(); } }
                                        if (root.oauth-has-session && !root.oauth-connecting): SecondaryButton {
                                            label: AppLocalization.translate(AppLocalization.current_locale, "Logout");
                                            clicked => {
                                                root.oauth-connecting = true;
                                                root.oauth-status = "Signing out…";
                                                root.oauth-logout-requested();
                                            }
                                        }
                                        Text { text: root.oauth-status; color: root.oauth-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                    if (root.oauth-connecting && root.oauth-authorize-url != ""): Field { label: AppLocalization.translate(AppLocalization.current_locale, "Sign-in link"); value <=> root.oauth-authorize-url; placeholder: AppLocalization.translate(AppLocalization.current_locale, ""); }
                                }
                            }
                            if (root.oauth-profile-loaded): Card {
                                VerticalLayout { spacing: 12px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Profile preview"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Rectangle {
                                        height: 130px; border-radius: 10px; background: root.oauth-accent-color;
                                        if (root.oauth-has-banner): Image { source: root.oauth-banner; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                    }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        if (root.oauth-has-avatar): Rectangle {
                                            width: 76px; height: 76px;
                                            border-radius: 38px;
                                            clip: true;
                                            Image { source: root.oauth-avatar; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                        }
                                        if (!root.oauth-has-avatar): Rectangle {
                                            width: 76px; height: 76px; border-radius: 38px; background: AppTheme.accent;
                                            Text { text: root.oauth-initials; color: AppTheme.on-brand; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text { text: root.oauth-display-name; color: AppTheme.text; font-size: 21px; font-weight: 700; }
                                            Text { text: root.oauth-username; color: AppTheme.muted; font-size: 14px; }
                                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "User ID: ") + root.oauth-user-id; color: AppTheme.subtle; font-size: 12px; }
                                        }
                                    }
                                    Rectangle {
                                        height: 1px;
                                        background: AppTheme.border;
                                    }
                                    Text { text: "ABOUT ME"; color: AppTheme.subtle; font-size: 11px; font-weight: 700; }
                                    Text {
                                        text: root.oauth-bio;
                                        color: AppTheme.text;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    Text { text: root.oauth-profile-art-status; color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Preview only — profile changes, roles and live presence are not fetched."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                            if (!root.oauth-profile-loaded): Card {
                                Text { text: AppLocalization.translate(AppLocalization.current_locale, "Sign in to preview your Discord display name, username, avatar and banner."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                            }
                        }

                        // ===================== CUSTOM RPC =====================
                        if (root.current-page == "Custom"): VerticalLayout {
                            spacing: 18px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Define a completely custom activity."); color: AppTheme.muted; font-size: 14px; wrap: word-wrap; }
                            Card {
                                VerticalLayout { spacing: 12px;
                                    ToggleRow { title: AppLocalization.translate(AppLocalization.current_locale, "Custom RPC enabled"); subtitle: AppLocalization.translate(AppLocalization.current_locale, "Run this mode independently of Media and Manual."); checked <=> root.rpc-custom-enabled; toggled => { root.rpc-mode-toggled("Custom", root.rpc-custom-enabled); } }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Name"); value <=> root.custom-name; placeholder: "Music Presence"; }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "Details"); value <=> root.custom-details; placeholder: "Listening to music"; }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "State"); value <=> root.custom-state; placeholder: "Artist · Album"; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SecondaryButton { label: "Playing"; active: root.custom-activity-type == "Playing"; clicked => { root.custom-activity-type = "Playing"; } }
                                        SecondaryButton { label: "Listening"; active: root.custom-activity-type == "Listening"; clicked => { root.custom-activity-type = "Listening"; } }
                                        SecondaryButton { label: "Watching"; active: root.custom-activity-type == "Watching"; clicked => { root.custom-activity-type = "Watching"; } }
                                        SecondaryButton { label: "Competing"; active: root.custom-activity-type == "Competing"; clicked => { root.custom-activity-type = "Competing"; } }
                                    }
                                    Text { text: "Assets & field URLs"; color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: "Large image key or URL"; value <=> root.custom-large-image; placeholder: "Optional"; }
                                        Field { label: "Large text"; value <=> root.custom-large-text; placeholder: "Optional"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: "Details URL"; value <=> root.custom-details-url; placeholder: "https://…"; }
                                        Field { label: "State URL"; value <=> root.custom-state-url; placeholder: "https://…"; }
                                    }
                                    Field { label: "Large image URL"; value <=> root.custom-large-url; placeholder: "https://…"; }
                                    Text { text: "Buttons"; color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: "Button 1 label"; value <=> root.custom-button1-label; placeholder: "Open"; }
                                        Field { label: "Button 1 URL"; value <=> root.custom-button1-url; placeholder: "https://…"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Field { label: "Button 2 label"; value <=> root.custom-button2-label; placeholder: "Channel"; }
                                        Field { label: "Button 2 URL"; value <=> root.custom-button2-url; placeholder: "https://…"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        PrimaryButton { label: "Apply custom presence"; clicked => { root.custom-presence-update-requested(); } }
                                        SecondaryButton { label: "Copy from Manual"; active: true; clicked => { root.custom-name = root.activity-name; root.custom-details = root.activity-details; root.custom-state = root.activity-state; root.custom-activity-type = root.activity-type; root.custom-large-image = root.large-image; root.custom-large-text = root.large-text; root.custom-button1-label = root.button1-label; root.custom-button1-url = root.button1-url; root.custom-button2-label = root.button2-label; root.custom-button2-url = root.button2-url; } }
                                    }
                                }
                            }
                        }

                        // ===================== SCROBBLING =====================
                        if (root.current-page == "Scrobbling"): VerticalLayout {
                            spacing: 18px;
                            Text { text: AppLocalization.translate(AppLocalization.current_locale, "Forward detected or manually entered songs to scrobbling services."); color: AppTheme.muted; font-size: 14px; wrap: word-wrap; }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Last.fm"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    HorizontalLayout { spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "API key"); value <=> root.scrobble-lastfm-api-key; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Last.fm API key"); enabled: !root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy; }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "API secret"); value <=> root.scrobble-lastfm-api-secret; secret: true; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Last.fm API secret"); enabled: !root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy; }
                                    }
                                    HorizontalLayout { spacing: 10px;
                                        if (!root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy): PrimaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Authorize"); clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-status = "Opening browser…"; root.scrobble-lastfm-authorize-requested(); } }
                                        if (root.scrobble-lastfm-pending && !root.scrobble-lastfm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Finish sign-in"); clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-status = "Finishing…"; root.scrobble-lastfm-finish-requested(); } }
                                        if (root.scrobble-lastfm-connected && !root.scrobble-lastfm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Disconnect"); clicked => { root.scrobble-lastfm-busy = true; root.scrobble-lastfm-disconnect-requested(); } }
                                        if (root.scrobble-lastfm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Working…"); active: false; clicked => {} }
                                        Text { text: root.scrobble-lastfm-status; color: root.scrobble-lastfm-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "ListenBrainz"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Field { label: AppLocalization.translate(AppLocalization.current_locale, "User token"); value <=> root.scrobble-listenbrainz-token; secret: true; placeholder: AppLocalization.translate(AppLocalization.current_locale, "listenbrainz.org/settings token"); enabled: !root.scrobble-listenbrainz-busy; }
                                    HorizontalLayout { spacing: 10px;
                                        if (!root.scrobble-listenbrainz-busy): PrimaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Save token"); clicked => { root.scrobble-listenbrainz-busy = true; root.scrobble-listenbrainz-status = "Saving…"; root.scrobble-listenbrainz-save-requested(); } }
                                        if (root.scrobble-listenbrainz-connected && !root.scrobble-listenbrainz-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Disconnect"); clicked => { root.scrobble-listenbrainz-busy = true; root.scrobble-listenbrainz-disconnect-requested(); } }
                                        if (root.scrobble-listenbrainz-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Working…"); active: false; clicked => {} }
                                        Text { text: root.scrobble-listenbrainz-status; color: root.scrobble-listenbrainz-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Libre.fm"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    HorizontalLayout { spacing: 8px;
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "API key"); value <=> root.scrobble-librefm-api-key; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Libre.fm API key"); enabled: !root.scrobble-librefm-connected && !root.scrobble-librefm-busy; }
                                        Field { label: AppLocalization.translate(AppLocalization.current_locale, "API secret"); value <=> root.scrobble-librefm-api-secret; secret: true; placeholder: AppLocalization.translate(AppLocalization.current_locale, "Libre.fm API secret"); enabled: !root.scrobble-librefm-connected && !root.scrobble-librefm-busy; }
                                    }
                                    HorizontalLayout { spacing: 10px;
                                        if (!root.scrobble-librefm-connected && !root.scrobble-librefm-busy): PrimaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Authorize"); clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-status = "Opening browser…"; root.scrobble-librefm-authorize-requested(); } }
                                        if (root.scrobble-librefm-pending && !root.scrobble-librefm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Finish sign-in"); clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-status = "Finishing…"; root.scrobble-librefm-finish-requested(); } }
                                        if (root.scrobble-librefm-connected && !root.scrobble-librefm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Disconnect"); clicked => { root.scrobble-librefm-busy = true; root.scrobble-librefm-disconnect-requested(); } }
                                        if (root.scrobble-librefm-busy): SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "Working…"); active: false; clicked => {} }
                                        Text { text: root.scrobble-librefm-status; color: root.scrobble-librefm-connected ? AppTheme.green : AppTheme.muted; font-size: 13px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // ===================== SETTINGS =====================
                        if (root.current-page == "Settings"): VerticalLayout {
                            spacing: 18px;
                            Card {
                                VerticalLayout { spacing: 10px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Language"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Choose the language used by the app. Missing translations fall back to English."); color: AppTheme.muted; font-size: 13px; wrap: word-wrap; }
                                    ComboBox {
                                        model: AppLocalization.language_options;
                                        current-value <=> AppLocalization.selected_language;
                                        selected(value) => { AppLocalization.language_selected(value); }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 12px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Appearance"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Discord-inspired colour scheme."); color: AppTheme.muted; font-size: 13px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "☾ Dark"); active: AppTheme.dark; clicked => { AppTheme.dark = true; } }
                                        SecondaryButton { label: AppLocalization.translate(AppLocalization.current_locale, "☀ Light"); active: !AppTheme.dark; clicked => { AppTheme.dark = false; } }
                                    }
                                }
                            }
                            Card {
                                VerticalLayout { spacing: 8px;
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "About"); color: AppTheme.text; font-size: 18px; font-weight: 700; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Music Presence — share what you listen to on Discord."); color: AppTheme.muted; font-size: 13px; }
                                    Text { text: AppLocalization.translate(AppLocalization.current_locale, "Detects over 100 media players, browser tabs and OS now-playing sessions. UI follows Discord's branding guidelines and Kizzy Enhanced's feature layout."); color: AppTheme.subtle; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
